#!/bin/sh
# Zez0000 button cap with a raised X on top (a cancel / no button). Stock cap is solid: 6.3 x 5.56
# flange, 4.3 x 3.56 body, domed top at z 4.41. Two bars 0.7 wide at +-45 deg, top at z 5.0, so
# the X stands 0.6 mm above the dome. Prints flange down, X up. Output case/zez0000/button_cap_x.stl
cd "$(dirname "$0")/.." || exit 1
exec "$HOME/.local/bin/uv" run --python 3.11 --with trimesh --with manifold3d --with numpy --with scipy --with shapely --with networkx --with rtree python - <<'PY'
import trimesh, numpy as np
cap = trimesh.load("case/zez0000/button_cap_1.stl")
cx, cy = (cap.bounds[0][:2] + cap.bounds[1][:2]) / 2
cap.apply_translation((-cx, -cy, 0))
BAR_L, BAR_W, Z0, Z1 = 3.4, 0.7, 3.8, 5.0
bars = []
for a in (np.pi / 4, -np.pi / 4):
    b = trimesh.creation.box(extents=(BAR_L, BAR_W, Z1 - Z0))
    b.apply_transform(trimesh.transformations.rotation_matrix(a, (0, 0, 1)))
    b.apply_translation((0, 0, (Z0 + Z1) / 2)); bars.append(b)
x = trimesh.boolean.union([cap] + bars, engine="manifold")
assert x.is_watertight, "cap not watertight"
x.export("case/zez0000/button_cap_x.stl")
s = x.section(plane_origin=[0, 0, 4.7], plane_normal=[0, 0, 1]); p, _ = s.to_2D()
print("button_cap_x: %.1f x %.1f x %.2f mm, X at z 4.7 is %.2f x %.2f, watertight" % (*x.extents, p.bounds[1][0] - p.bounds[0][0], p.bounds[1][1] - p.bounds[0][1]))
PY
