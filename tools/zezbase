#!/bin/sh
# Rework the Zez0000 base (case/zez0000/base.stl) so it snaps into the stock lid without a mallet.
# Stock: two 53 mm tabs, each with a full-length half-round ridge 0.44 mm proud of the lid wall,
# zero end clearance. Here: ridge removed, tab shaved to 0.1 mm side clearance and 0.25 mm end
# clearance, then four 10 mm ridges (r 0.4) put back, 0.25 mm proud, landing in the lid groove.
# Frame: base STL as downloaded, z=0 floor, rim at z=11, tabs z 11..13. Centre of the shell in x,y.
cd "$(dirname "$0")/.." || exit 1
exec "$HOME/.local/bin/uv" run --python 3.11 --with trimesh --with manifold3d --with numpy --with scipy --with shapely --with networkx --with rtree python - <<'PY'
import trimesh, numpy as np
base = trimesh.load("case/zez0000/base.stl")
cx, cy = (base.bounds[0][:2] + base.bounds[1][:2]) / 2
base.apply_translation((-cx, -cy, 0))

WALL_IN = 27.13 / 2          # lid cavity half-width (inner face of the lid wall)
TAB_OUT = WALL_IN - 0.10     # new tab outer face: 0.1 clearance to the lid wall
TAB_END = 26.25              # new tab half-length (stock 26.4/26.6, lid pocket 26.5): 0.25 per end
RIDGE_R, RIDGE_LEN, RIDGE_X, RIDGE_PROUD = 0.4, 10.0, 16.0, 0.25
RIDGE_Y = WALL_IN + RIDGE_PROUD - RIDGE_R   # cylinder centre so the crest is 0.25 past the wall
RIDGE_Z = 12.5               # stock ridge centre; meets the lid groove centre (lid z 14.1)

def box(x0, x1, y0, y1, z0, z1):
    b = trimesh.creation.box(extents=(x1 - x0, y1 - y0, z1 - z0))
    b.apply_translation(((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)); return b

cuts = []
for s in (1, -1):
    y0, y1 = sorted((s * TAB_OUT, s * 20.0))
    cuts.append(box(-40, 40, y0, y1, 11.0, 14.0))          # ridge + 0.1 off the tab face
cuts.append(box(-40, -TAB_END, -20, 20, 11.0, 14.0))        # tab ends
cuts.append(box(TAB_END, 40, -20, 20, 11.0, 14.0))
b2 = trimesh.boolean.difference([base] + cuts, engine="manifold")

ridges = []
for sx in (1, -1):
    for sy in (1, -1):
        c = trimesh.creation.cylinder(radius=RIDGE_R, height=RIDGE_LEN, sections=64)
        c.apply_transform(trimesh.transformations.rotation_matrix(np.pi / 2, (0, 1, 0)))
        c.apply_translation((sx * RIDGE_X, sy * RIDGE_Y, RIDGE_Z)); ridges.append(c)
b3 = trimesh.boolean.union([b2] + ridges, engine="manifold")
assert b3.is_watertight, "base not watertight"
b3.export("case/zez0000/base_v2.stl")

v = b3.vertices; t = v[v[:, 2] > 11.01]
print("tabs: x %.2f..%.2f, |y| max %.2f (wall at %.3f); ridges crest |y| %.2f, %d mm long at x=+-%.0f, z %.1f..%.1f" % (
    t[:, 0].min(), t[:, 0].max(), np.abs(t[np.abs(t[:, 1]) < 13.6][:, 1]).max(), WALL_IN,
    np.abs(t[:, 1]).max(), RIDGE_LEN, RIDGE_X, RIDGE_Z - RIDGE_R, RIDGE_Z + RIDGE_R))
print("base_v2: %.1f x %.1f x %.1f mm, watertight" % tuple(b3.extents))
PY
